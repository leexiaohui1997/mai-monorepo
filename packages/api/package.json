{
  "name": "@mai/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "compile:win": "bun build src/index.ts --compile --outfile dist/mai-api.exe",
    "compile:mac-arm": "bun build src/index.ts --compile --outfile dist/mai-api",
    "compile:mac-intel": "bun build src/index.ts --compile --outfile dist/mai-api"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/mcp": "^1.0.36",
    "@ai-sdk/openai": "^1.0.0",
    "ai": "^4.0.0",
    "axios": "^1.15.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "env-paths": "^3.0.0",
    "express": "^4.19.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/pino": "^7.0.5",
    "@types/uuid": "^10.0.0",
    "bun-types": "latest"
  }
}
