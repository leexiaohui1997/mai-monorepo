{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MAI",
  "version": "0.1.0",
  "identifier": "com.mai.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node scripts/dev-launcher.js",
    "beforeBuildCommand": "node scripts/build-sidecar.js && pnpm --filter web build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MAI Desktop",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/mai-api-macos/**/*"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
